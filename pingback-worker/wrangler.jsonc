{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bala-pingback-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://balamenon.com,https://www.balamenon.com,https://balamenon.github.io",
    "TURNSTILE_HOSTNAMES": "balamenon.com,www.balamenon.com,balamenon.github.io"
  },
  "queues": {
    "producers": [
      {
        "binding": "PINGBACKS",
        "queue": "bala-pingbacks"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "PINGBACK_RATE_LIMITER",
      "namespace_id": "31001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
